# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.

# Required for Eve (the tutor) and for AI grading. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Model used for Eve and grading. Defaults to claude-opus-5.
# EVE_MODEL=claude-opus-5

# Optional. How hard Eve thinks: low | medium | high. Defaults to medium (snappier answers).
# EVE_EFFORT=medium

# Optional. Set to "off" to disable server-side refusal fallbacks. Defaults to on.
# ANTHROPIC_FALLBACKS=on

# Optional. Neon Postgres connection string. Without it, progress is stored in the browser only.
# Get one at https://neon.tech → your project → Connection string (use the pooled one).
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
